{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umsi212f2026.github.io/student-showcase/project.schema.json",
  "title": "SI 212 Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assignment",
    "studentName",
    "projectTitle",
    "description",
    "projectType",
    "projectUrl"
  ],
  "properties": {
    "assignment": { "type": "string", "enum": ["Problem Set 3", "Final Project"] },
    "studentName": { "type": "string", "minLength": 2 },
    "projectTitle": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 10 },
    "projectType": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "Web App",
          "Data Visualization",
          "Simulation",
          "API/Backend",
          "Mobile App",
          "Other"
        ]
      }
    },
    "projectUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "githubUrl": { "type": "string", "format": "uri" },
    "projectImage": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "reflections": { "type": "string" },
    "studentPhoto": { "type": "string" },
    "videoUrl": { "type": "string", "format": "uri" }
  }
}
